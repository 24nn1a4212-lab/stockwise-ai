# StockWise AI Configuration

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# Leave empty to automatically run in offline Demo Mode with local JSON persistence!
MONGODB_URI=

# Database Name
DB_NAME=stockwise_ai

# Set to true to force offline Demo Mode even if MONGODB_URI is provided
FORCE_DEMO_MODE=false

# Port configurations
PORT=8000
HOST=127.0.0.1
